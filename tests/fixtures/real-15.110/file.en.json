   "__list_js": "\n\n/* Adding apps/frappe/frappe/core/doctype/file/file_list.js */\n\nfrappe.listview_settings[\"File\"] = {\n\tformatters: {\n\t\tfile_name: function (value) {\n\t\t\treturn frappe.utils.escape_html(value || \"\");\n\t\t},\n\t},\n};\n\n\n//# sourceURL=file__list_js",
