+// Rehearsal: FrappeListView inside Sear, on Sear's own React Query client, against a SIMULATED Frappe site (no network,
+// no live environment). Real-site validation is deferred.
+import { useState } from "react";
+import { useQueryClient } from "@tanstack/react-query";
+import { queryClient } from "@/lib/queryClient";
+import { FrappeListView, createFrappeClient } from "@solvfast/ui/frappe";
+import { createMockFrappe } from "./mock-frappe";
+
+export default function FrappeRehearsalPage() {
+  const [client] = useState(() => createFrappeClient({ transport: createMockFrappe({ latencyMs: 80 }).transport }));
+  const inUse = useQueryClient(); // probe: is FrappeListView on Sear's own React Query client?
+  return (
+    <div className="px-6 md:px-8 py-6">
+      <span hidden data-testid="sfui-qc">{inUse === queryClient ? "shared" : "separate"}</span>
+      <FrappeListView doctype="ToDo" client={client} storage={null} groupByFields={["status", "priority"]}
+        columns={[{ key: "description", label: { en: "Task", ar: "المهمة" }, type: "text", fieldtype: "Text Editor" }]}
+        fieldLabels={{ status: { en: "Status", ar: "الحالة" }, priority: { en: "Priority", ar: "الأولوية" }, date: { en: "Due Date", ar: "تاريخ الاستحقاق" }, reference_type: { en: "Reference Type", ar: "نوع المرجع" } }} />
+    </div>
+  );
+}
