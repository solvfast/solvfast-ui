+// Rehearsal: Sear's Field Library data (its own store) through @solvfast/ui's ListView, inside Sear's studio shell.
+import { useMemo, useSyncExternalStore } from "react";
+import { useNavigate } from "react-router-dom";
+import { Plus, Trash2 } from "lucide-react";
+import { Button, ListView, type ColumnDef } from "@solvfast/ui";
+import { useApp } from "@/contexts/AppContext";
+import { fieldLibraryStore } from "@sear/pages/FieldLibrary/fieldLibraryStore";
+import { SEAR_STUDIO_BASE } from "@sear/lib/searStudioBase";
+
+type Row = { name: string; preset_name: string; description: string; fields_count: number; created_by: string; modified_at: Date };
+
+export default function ListRehearsalPage() {
+  const { language } = useApp();
+  const isRTL = language === "ar";
+  const navigate = useNavigate();
+  const presets = useSyncExternalStore(fieldLibraryStore.subscribe, fieldLibraryStore.list);
+  const rows = useMemo<Row[]>(() => presets.map((p) => ({
+    name: p.id, preset_name: isRTL ? p.nameAr || p.name : p.name, description: p.description ?? "",
+    fields_count: p.fields.length, created_by: p.createdBy, modified_at: p.modifiedAt,
+  })), [presets, isRTL]);
+  const fmt = (d: Date) => new Intl.DateTimeFormat(isRTL ? "ar-EG" : "en-GB", { day: "2-digit", month: "short", year: "numeric" }).format(d);
+  const columns: ColumnDef<Row>[] = [
+    { key: "preset_name", label: { en: "Name", ar: "الاسم" }, type: "text", render: (r) => (
+      <div className="min-w-0"><p className="font-medium text-sm truncate">{r.preset_name}</p>{r.description && <p className="text-[11px] text-muted-foreground truncate">{r.description}</p>}</div>
+    ) },
+    { key: "fields_count", label: { en: "Fields", ar: "الحقول" }, type: "number", fieldtype: "Int" },
+    { key: "created_by", label: { en: "Created By", ar: "أنشئت بواسطة" }, type: "text", hidden: true },
+    { key: "modified_at", label: { en: "Last Modified", ar: "آخر تعديل" }, type: "date", sortValue: (r) => r.modified_at.getTime(), render: (r) => <span className="text-xs text-muted-foreground">{fmt(r.modified_at)}</span> },
+  ];
+  return (
+    <div className="px-6 md:px-8 py-6">
+      <ListView<Row>
+        rows={rows} columns={columns} rowKey={(r) => r.name} viewKey="sfui-rehearsal-field-library"
+        onRowClick={(r) => navigate(`${SEAR_STUDIO_BASE}/field_library/${r.name}/edit`)}
+        rowActions={[{ key: "delete", label: { en: "Delete", ar: "حذف" }, icon: Trash2, tone: "destructive", onSelect: (r) => fieldLibraryStore.remove(r.name),
+          confirm: { title: { en: "Delete this preset?", ar: "حذف هذه المجموعة؟" }, confirmLabel: { en: "Delete", ar: "حذف" } } }]}
+        selectable groupByOptions={[{ key: "created_by", label: isRTL ? "أنشئت بواسطة" : "Created By", groupOf: (r) => ({ key: r.created_by, label: r.created_by }) }]}
+        controls={{ sortMenu: true }}
+        toolbarActions={<Button className="gap-2 shrink-0" onClick={() => navigate(`${SEAR_STUDIO_BASE}/field_library/new`)}><Plus className="h-4 w-4" />{isRTL ? "إنشاء مجموعة حقول" : "Create Field Preset"}</Button>}
+      />
+    </div>
+  );
+}
