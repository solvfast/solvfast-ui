+// @solvfast/ui's ThemeProvider, driven by Sear's own AppContext (the single owner of theme and language in Sear):
+// controlled props, no storage of its own, so the two can never disagree.
+import type { ReactNode } from "react";
+import { ThemeProvider } from "@solvfast/ui";
+import { useApp } from "@/contexts/AppContext";
+
+export function SfuiThemeBridge({ children }: { children: ReactNode }) {
+  const { theme, language } = useApp();
+  return <ThemeProvider theme={theme} language={language} storageKeys={null}>{children}</ThemeProvider>;
+}
