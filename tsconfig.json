{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": [
      "vite/client"
    ],
    "paths": {
      "@ui": [
        "./src/index.ts"
      ],
      "@ui/frappe": [
        "./src/frappe/index.ts"
      ]
    },
    "baseUrl": "."
  },
  "include": [
    "src",
    "tests",
    "playground/src",
    "showcase/src",
    "e2e/frappe-site/harness",
    "tailwind-preset.ts"
  ]
}